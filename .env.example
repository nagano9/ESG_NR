# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PostgreSQL runtime connection used by the Express API.
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="postgres"
SQL_DB_NAME="aipulse_esg"

# PostgreSQL admin connection used by Drizzle Kit migrations.
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="postgres"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: seed demo ESG data when the server starts in a local environment.
SEED_ON_STARTUP="false"

# Comma-separated Firebase/Google emails that can view every PLN NR entity.
PLN_NR_ADMIN_EMAILS="sustainability.lead@pln-nr.example"

# JSON map of JV user email to allowed organization id(s). A JV user only sees these orgs.
# Example: {"jv-a.pic@example.com":1,"jv-b.pic@example.com":[2]}
JV_ENTITY_ACCESS="{\"jv-a.pic@example.com\":1,\"jv-b.pic@example.com\":2}"
